[Unit]
Description=Linux Stats Display (Conky)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitBurst=0

[Service]
Type=forking
WorkingDirectory=%h/workspaces/zozo_ws/linux-stats-display
# Conky will fork to background (background=true in config)
ExecStart=/usr/bin/conky -c %h/workspaces/zozo_ws/linux-stats-display/.config/conky/stats.conf
Restart=always
RestartSec=3
TimeoutStopSec=3
KillSignal=SIGKILL
StandardOutput=journal
StandardError=journal

# Ensure display is available for conky
# Note: If conky doesn't appear, check your DISPLAY with: echo $DISPLAY
# Update this line to match your system (common values: :0, :1, or :0.0)
Environment="DISPLAY=:1"
Environment="XAUTHORITY=%h/.Xauthority"

[Install]
WantedBy=graphical-session.target
